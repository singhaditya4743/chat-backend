### Requests for the VS Code "REST Client" extension
@baseUrl = http://localhost:5000
@aliceId = 11111111-1111-4111-8111-111111111111
@bobId = 22222222-2222-4222-8222-222222222222
# Paste the chatId returned by /chat/create here
@chatId = paste-chat-id-here

### Create (or get) the Alice-Bob chat: 201 first time, 200 after
POST {{baseUrl}}/chat/create
Content-Type: application/json

{
  "userAId": "{{aliceId}}",
  "userBId": "{{bobId}}"
}

### Same pair reversed: returns the same chatId
POST {{baseUrl}}/chat/create
Content-Type: application/json

{
  "userAId": "{{bobId}}",
  "userBId": "{{aliceId}}"
}

### Validation error: same user twice
POST {{baseUrl}}/chat/create
Content-Type: application/json

{
  "userAId": "{{aliceId}}",
  "userBId": "{{aliceId}}"
}

### Not found: unknown user
POST {{baseUrl}}/chat/create
Content-Type: application/json

{
  "userAId": "{{aliceId}}",
  "userBId": "99999999-9999-4999-8999-999999999999"
}

### Send a message (sender must be a member of the chat)
POST {{baseUrl}}/chat/{{chatId}}/message/send
Content-Type: application/json

{
  "senderId": "{{aliceId}}",
  "text": "Hi Bob"
}

### Get the latest messages, oldest first
GET {{baseUrl}}/chat/{{chatId}}/messages?limit=50

### Load older messages: use nextCursor from the previous response
GET {{baseUrl}}/chat/{{chatId}}/messages?limit=50&before=paste-next-cursor-here

### Mark a message as read (Bob reads Alice's message)
POST {{baseUrl}}/chat/{{chatId}}/message/paste-message-id-here/read
Content-Type: application/json

{
  "userId": "{{bobId}}"
}

### Update Bob's last seen message in this chat
POST {{baseUrl}}/chat/{{chatId}}/lastseen
Content-Type: application/json

{
  "userId": "{{bobId}}",
  "messageId": "paste-message-id-here"
}
